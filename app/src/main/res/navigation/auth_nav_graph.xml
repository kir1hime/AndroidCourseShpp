<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.androidcourseshpp.ui.screens.auth.signup.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_signUpExtendedFragment"
            app:destination="@id/signUpExtendedFragment"
            app:enterAnim="@anim/slide_in_from_right_to_left"
            app:exitAnim="@anim/slide_out_from_right_to_left"
            app:popEnterAnim="@anim/slide_in_from_left_to_right"
            app:popExitAnim="@anim/slide_out_from_left_to_right" />
    </fragment>
    <fragment
        android:id="@+id/signUpExtendedFragment"
        android:name="com.example.androidcourseshpp.ui.screens.auth.signupextended.SignUpExtendedFragment"
        android:label="fragment_sign_up_extended"
        tools:layout="@layout/fragment_sign_up_extended">
        <argument
            android:name="signUpInfo"
            app:argType="com.example.androidcourseshpp.ui.screens.auth.signup.entity.SignUpUserInfoEntity" />
        <action
            android:id="@+id/action_signUpExtendedFragment_to_chooseProfilePhotoDialog"
            app:destination="@id/chooseProfilePhotoDialog" />

    </fragment>
    <dialog
        android:id="@+id/chooseProfilePhotoDialog"
        android:name="com.example.androidcourseshpp.ui.screens.main.chooseprofilephotodialog.ChooseProfilePhotoDialog"
        android:label="dialog_choose_profile_photo"
        tools:layout="@layout/dialog_choose_profile_photo" />
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.androidcourseshpp.ui.screens.auth.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.androidcourseshpp.ui.screens.auth.signin.SignInFragment"
        android:label="fragment_sign_in"
        tools:layout="@layout/fragment_sign_in" >
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment"
            app:enterAnim="@anim/slide_in_from_right_to_left"
            app:exitAnim="@anim/slide_out_from_right_to_left"
            app:popEnterAnim="@anim/slide_in_from_left_to_right"
            app:popExitAnim="@anim/slide_out_from_left_to_right"/>
    </fragment>

</navigation>