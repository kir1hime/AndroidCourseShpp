<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/userInfoFragment">

    <fragment
        android:id="@+id/contactDetailsFragment"
        android:name="com.example.androidcourseshpp.ui.screens.contactdetails.ContactDetailsFragment"
        android:label="fragment_detailview"
        tools:layout="@layout/fragment_detailview">
        <argument
            android:name="contactDetails"
            app:argType="com.example.androidcourseshpp.data.contactlist.ContactItem" />

    </fragment>
    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.example.androidcourseshpp.ui.screens.userinfo.UserInfoFragment"
        android:label="fragment_userinfo"
        tools:layout="@layout/fragment_userinfo">
        <action
            android:id="@+id/action_userInfoFragment_to_contactDetailsFragment"
            app:destination="@id/contactDetailsFragment"
            app:enterAnim="@anim/slide_in_from_right_to_left"
            app:exitAnim="@anim/slide_out_from_right_to_left"
            app:popEnterAnim="@anim/slide_in_from_left_to_right"
            app:popExitAnim="@anim/slide_out_from_left_to_right" />
        <action
            android:id="@+id/action_userInfoFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment"
            app:enterAnim="@anim/slide_in_from_top_to_bottom"
            app:exitAnim="@anim/slide_out_from_top_to_bottom"
            app:popEnterAnim="@anim/slide_in_from_bottom_to_top"
            app:popExitAnim="@anim/slide_out_from_bottom_to_top" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.androidcourseshpp.ui.screens.editprofile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile">
        <argument
            android:name="userInfo"
            app:argType="com.example.androidcourseshpp.ui.UserInfoEntity" />
        <action
            android:id="@+id/action_editProfileFragment_to_chooseProfilePhotoDialog2"
            app:destination="@id/chooseProfilePhotoDialog2" />
    </fragment>
    <dialog
        android:id="@+id/chooseProfilePhotoDialog2"
        android:name="com.example.androidcourseshpp.ui.screens.auth.signupextended.chooseprofilephotodialog.ChooseProfilePhotoDialog"
        android:label="dialog_choose_profile_photo"
        tools:layout="@layout/dialog_choose_profile_photo" />
</navigation>