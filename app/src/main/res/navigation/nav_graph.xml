<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/userInfoFragment">

    <fragment
        android:id="@+id/contactDetailsFragment"
        android:name="com.example.androidcourseshpp.ui.screens.contactdetails.ContactDetailsFragment"
        android:label="fragment_detailview"
        tools:layout="@layout/fragment_detailview">
        <argument
            android:name="contactDetails"
            app:argType="com.example.androidcourseshpp.data.contactlistdata.ContactItem" />

    </fragment>
    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.example.androidcourseshpp.ui.screens.userinfo.UserInfoFragment"
        android:label="fragment_userinfo"
        tools:layout="@layout/fragment_userinfo" >
        <action
            android:id="@+id/action_userInfoFragment_to_contactDetailsFragment"
            app:destination="@id/contactDetailsFragment"
            app:enterAnim="@anim/slide_in_from_right_to_left"
            app:exitAnim="@anim/slide_out_from_right_to_left"
            app:popEnterAnim="@anim/slide_in_from_left_to_right"
            app:popExitAnim="@anim/slide_out_from_left_to_right"/>
    </fragment>
</navigation>