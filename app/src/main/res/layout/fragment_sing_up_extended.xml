<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sign_up_extended_background">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/circleImageViewProfilePhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mockup_profile_photo_margin_top"
        android:layout_marginBottom="@dimen/mockup_profile_photo_margin_bottom"
        android:src="@drawable/profile_mockup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonAddProfilePhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/add_prof_photo_image_button_margin_start"
        android:layout_marginTop="@dimen/add_prof_photo_image_button_margin_top"
        android:layout_marginBottom="@dimen/add_prof_photo_image_button_margin_bottom"
        android:background="@null"
        android:src="@drawable/add_profile_photo_ic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/circleImageViewProfilePhoto"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/main_margin_side"
        android:layout_marginTop="@dimen/your_profile_data_text_margin_top"
        android:layout_marginBottom="@dimen/your_profile_data_text_margin_bottom"
        android:fontFamily="@font/open_sans"
        android:text="@string/your_profile_data"
        android:textAlignment="center"
        android:textColor="@color/your_profile_data_text_color"
        android:textSize="@dimen/large_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>