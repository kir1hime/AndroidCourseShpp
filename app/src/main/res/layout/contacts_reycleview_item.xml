<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vw_itemField"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contacts_recycle_view_item_h"
        android:background="@drawable/contacts_recycle_view_item_background"
        android:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="@dimen/contacts_recycle_view_item_ava_size"
        android:layout_height="@dimen/contacts_recycle_view_item_ava_size"
        android:layout_marginStart="@dimen/contacts_recycle_view_margin_start"
        android:src="@drawable/profile_photo"
        app:layout_constraintTop_toTopOf="@id/vw_itemField"
        app:layout_constraintBottom_toBottomOf="@id/vw_itemField"
        app:layout_constraintStart_toStartOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>