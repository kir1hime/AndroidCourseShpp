<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/darkBlueLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="62dp"
        android:background="@color/darkBlue"
        app:layout_constraintBottom_toTopOf="@id/socialNetworksLayout"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_height="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="17dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans"
                android:lineHeight="31.2dp"
                android:paddingTop="4.5dp"
                android:paddingBottom="4.5dp"
                android:text="@string/settings"
                android:textColor="@color/white"
                android:textFontWeight="600"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:layout_width="119dp"
                android:layout_height="40dp"
                android:background="@drawable/log_out_background"
                android:fontFamily="@font/open_sans"
                android:lineHeight="18.2dp"
                android:text="@string/log_out"
                android:textColor="@color/lightGray"
                android:textFontWeight="600"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/view_my_cont_butt"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/view_my_contacts_background"
        android:fontFamily="@font/open_sans"
        android:letterSpacing="0.15"
        android:lineHeight="24dp"
        android:paddingVertical="8dp"
        android:text="@string/view_my_contacts"
        android:textFontWeight="600"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/edit_prof_butt"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_profile_background"
        android:fontFamily="@font/open_sans"
        android:lineHeight="18.2dp"
        android:paddingVertical="8dp"
        android:text="@string/edit_profile"
        android:textColor="@color/darkGray"
        android:textFontWeight="600"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/view_my_cont_butt" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/socialNetworksLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="58dp"
        android:layout_marginTop="438dp"
        android:layout_marginBottom="222dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/social_networks_background"
            android:contentDescription="@null"
            android:src="@drawable/ic_facebook"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/social_networks_background"
            android:contentDescription="@null"
            android:src="@drawable/ic_linkedin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/linkedin_butt"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="60dp"
            android:background="@drawable/social_networks_background"
            android:contentDescription="@null"
            android:src="@drawable/ic_inst"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>