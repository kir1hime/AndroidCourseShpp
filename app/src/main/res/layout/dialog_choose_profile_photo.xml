<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/top_view_color"
    tools:context="com.example.androidcourseshpp.ui.screens.auth.ChooseProfilePhotoDialog">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewChooseProfilePhotoDialog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/choose_profile_photo_dialog_h"
        android:background="@color/top_view_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/main_margin_side"
        android:fontFamily="@font/open_sans"
        android:text="@string/cancel"
        android:textColor="@color/cancel_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/open_gallery_text_margin_bottom"
        android:fontFamily="@font/open_sans"
        android:text="@string/open_gallery"
        android:textColor="@color/open_gallery_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>