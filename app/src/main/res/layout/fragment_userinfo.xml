<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:id="@+id/userInfo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tool:context="com.example.androidcourseshpp.ui.screens.userinfo.UserInfoFragment">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_userInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tl_userInfo"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_userInfo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabLayout_h"
        android:backgroundTint="@color/tabLayout_background_color"
        app:layout_constraintTop_toTopOf="parent"
        app:tabMode="fixed"
       app:tabGravity="fill"
        app:tabSelectedTextColor="@color/tabSelected_text_color"
        app:tabTextAppearance="@style/tabItemsTextStyle"
        app:tabTextColor="@color/tabUnselected_text_color">

        <com.google.android.material.tabs.TabItem
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tool:text="My Profile" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tool:text="Contacts" />

    </com.google.android.material.tabs.TabLayout>

</androidx.constraintlayout.widget.ConstraintLayout>