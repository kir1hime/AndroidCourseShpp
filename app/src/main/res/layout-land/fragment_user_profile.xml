<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.androidcourseshpp.ui.screens.main.userinfo.userprofile.UserProfileFragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewTopPartOfScreen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/top_view_color"
        app:layout_constraintEnd_toStartOf="@id/GuideLineMiddleVer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewWhitePartOfScreen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/bottom_view_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/GuideLineMiddleVer" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GuideLineMiddleVer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSettingAndLogOut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/main_margin_side"
        android:layout_marginTop="@dimen/main_margin_side"
        app:layout_constraintBottom_toBottomOf="@id/textViewSettings"
        app:layout_constraintEnd_toEndOf="@id/textViewTopPartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewTopPartOfScreen"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans"
        android:paddingVertical="@dimen/settings_padding_vertical"
        android:text="@string/settings"
        android:textColor="@color/settings_text_color"
        android:textSize="@dimen/large_text_size"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="@id/textViewSettingAndLogOut"
        app:layout_constraintTop_toTopOf="@id/textViewSettingAndLogOut" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonLogOut"
        android:layout_width="@dimen/log_out_bt_w"
        android:layout_height="@dimen/log_out_bt_h"
        android:background="@drawable/log_out_background"
        android:fontFamily="@font/open_sans"
        android:text="@string/log_out"
        android:textAllCaps="false"
        android:textColor="@color/log_out_border_and_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="@id/textViewSettingAndLogOut"
        app:layout_constraintTop_toTopOf="@id/textViewSettingAndLogOut" />


    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/circleViewProfilePhoto"
        android:layout_width="@dimen/profile_photo_size"
        android:layout_height="@dimen/profile_photo_size"
        android:layout_marginTop="@dimen/profile_photo_margin_top"
        android:layout_marginBottom="@dimen/profile_photo_margin_bottom"
        android:contentDescription="@string/profile_photo"
        android:src="@drawable/profile_photo"
        app:layout_constraintBottom_toBottomOf="@id/GuideLineMiddleVer"
        app:layout_constraintEnd_toEndOf="@id/textViewTopPartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewTopPartOfScreen"
        app:layout_constraintTop_toTopOf="@id/textViewTopPartOfScreen" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/name_margin_horizontal"
        android:layout_marginTop="@dimen/name_margin_top"
        android:layout_marginBottom="@dimen/name_margin_bottom"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:text="@string/name"
        android:textColor="@color/name_text_color"
        android:textSize="@dimen/big_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/GuideLineMiddleVer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewCareer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/career_margin_horizontal"
        android:layout_marginTop="@dimen/career_margin_top"
        android:fontFamily="@font/open_sans"
        android:gravity="center"
        android:text="@string/career"
        android:textColor="@color/career_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/GuideLineMiddleVer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewName" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewHomeAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/home_address_margin_horizontal"
        android:layout_marginTop="@dimen/home_address_margin_top"
        android:fontFamily="@font/open_sans"
        android:text="@string/home_address"
        android:textAlignment="center"
        android:textColor="@color/home_address_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewTopPartOfScreen"
        app:layout_constraintTop_toBottomOf="@id/textViewCareer" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonViewMyContacts"
        android:layout_width="0dp"
        android:layout_height="@dimen/view_my_contacts_bt_h"
        android:layout_marginHorizontal="@dimen/main_margin_side"
        android:layout_marginBottom="@dimen/bt_margin_bottom"
        android:background="@drawable/view_my_contacts_background"
        android:fontFamily="@font/open_sans"
        android:letterSpacing="0.15"
        android:text="@string/view_my_contacts"
        android:textColor="@color/view_my_contacts_text_color"
        android:textSize="@dimen/middle_text_size"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewWhitePartOfScreen" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonMessage"
        android:layout_width="0dp"
        android:layout_height="@dimen/edit_profile_bt_h"
        android:layout_marginHorizontal="@dimen/main_margin_side"
        android:layout_marginBottom="@dimen/bt_margin_bottom"
        android:background="@drawable/edit_profile_background"
        android:fontFamily="@font/open_sans"
        android:text="@string/edit_profile"
        android:textAllCaps="false"
        android:textColor="@color/edit_profile_text_color"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/buttonViewMyContacts"
        app:layout_constraintEnd_toEndOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewWhitePartOfScreen" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonFacebook"
        style="@style/social_network_style"
        android:layout_marginStart="@dimen/social_network_side_margin"
        android:contentDescription="@string/facebook_button"
        android:src="@drawable/ic_facebook"
        app:layout_constraintBottom_toBottomOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintStart_toStartOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintTop_toTopOf="@id/textViewWhitePartOfScreen" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonLinkedIn"
        style="@style/social_network_style"
        android:contentDescription="@string/linkedin_button"
        android:src="@drawable/ic_linkedin"
        app:layout_constraintBottom_toBottomOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintTop_toTopOf="@id/textViewWhitePartOfScreen" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonInstagram"
        style="@style/social_network_style"
        android:layout_marginEnd="@dimen/social_network_side_margin"
        android:contentDescription="@string/instagram_button"
        android:src="@drawable/ic_inst"
        app:layout_constraintBottom_toBottomOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintEnd_toEndOf="@id/textViewWhitePartOfScreen"
        app:layout_constraintTop_toTopOf="@id/textViewWhitePartOfScreen" />

</androidx.constraintlayout.widget.ConstraintLayout>